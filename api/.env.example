# Copy to api/.env and fill in. Never commit api/.env.
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key: the API and the offline scripts only. Never put it in the web app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Password shared by the seeded demo accounts (scripts/seed_demo_users.py); the web server needs the same value.
DEMO_PASSWORD=choose-a-long-random-password
# Comma-separated frontend origins allowed by CORS (default http://localhost:3000).
CORS_ORIGINS=http://localhost:3000
