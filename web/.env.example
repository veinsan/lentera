# Copy to web/.env.local and fill in. Never commit web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable anon key; row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: the one-click demo sign-in uses it and never sends it to the browser.
DEMO_PASSWORD=same-value-as-in-api-env
# FastAPI service: API_URL for server reads, NEXT_PUBLIC_API_URL for browser uploads (default http://127.0.0.1:8000).
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Public site URL for metadata, robots, and the sitemap (default https://lentera-khaki.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
